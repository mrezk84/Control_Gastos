# URL pública del backend en producción. NO es un secreto: el navegador la necesita en cada petición
# y cualquiera puede verla en la pestaña Red. Create React App la incorpora al compilar.
#
# Si defines REACT_APP_API_URL en las variables de entorno de Vercel, esa tiene prioridad sobre este archivo.
# No pongas aquí NUNCA secretos (claves, contraseñas, DATABASE_URL): todo lo que empieza por REACT_APP_
# queda a la vista de cualquiera que abra la web.
#
# Debe ser un proyecto de Vercel que controles: los nombres *.vercel.app son de quien los registra primero.
REACT_APP_API_URL=https://control-gastos-api-rose.vercel.app
