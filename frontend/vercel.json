{
  "version": 2,
  "name": "control-gastos-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "@backend-api-url"
  },
  "build": {
    "env": {
      "REACT_APP_API_URL": "@backend-api-url"
    }
  }
}