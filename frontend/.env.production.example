# Production environment variables for Vercel/Render
# Estas variables se configuran en Vercel/Render Dashboard

# URL del backend desplegado en Render
REACT_APP_API_URL=https://control-gastos-backend.onrender.com

# Supabase (Project Settings > API). La anon/publishable key es pública por diseño.
REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<anon-key>

# Alternative URLs (ejemplos)
# REACT_APP_API_URL=https://tu-proyecto-backend.onrender.com
# REACT_APP_API_URL=https://api.tudominio.com
