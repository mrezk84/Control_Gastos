# Base de datos (Neon Postgres)
# Neon > Dashboard > Connect > "Pooled connection" (el host lleva "-pooler").
DATABASE_URL=postgresql://<usuario>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Autenticación: clave para firmar los JWT. Generala con:  openssl rand -hex 32
SECRET_KEY=
# Minutos de vida del token de sesión (por defecto 1440 = 24 h)
TOKEN_EXPIRATION=1440

# URL(s) del frontend para CORS y redirecciones (separadas por coma si son varias)
# Local:
FRONTEND_URL=http://localhost:3000
# Producción:
# FRONTEND_URL=https://control-gastos.vercel.app

# URL pública de este backend (se usa para los callbacks de OAuth)
BACKEND_URL=http://localhost:8000

# Recuperación de contraseña por correo (Resend, gratis hasta 3000 correos/mes).
# Sin RESEND_API_KEY el enlace solo se escribe en el log del servidor.
RESEND_API_KEY=
EMAIL_FROM=Control Gastos <onboarding@resend.dev>

# OCR de recibos (https://ocr.space/ocrapi/freekey). Sin clave no se pueden escanear imágenes.
OCR_SPACE_API_KEY=

# Login social (opcional). Redirect URI a registrar: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI a registrar: {BACKEND_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Notificaciones del navegador (Web Push). Genera el par con:  npx web-push generate-vapid-keys
# La pública también la lee el navegador (GET /push/vapid-key). Sin ellas solo hay notificaciones en la app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com

# Protege GET /cron/reminders (Vercel Cron lo envía como "Authorization: Bearer <valor>"). Genera con: openssl rand -hex 32
# Sin esta variable el endpoint responde 503 y no avisa nada.
CRON_SECRET=

# Hosts adicionales permitidos para Web Push (por defecto solo FCM, Mozilla, Apple y Windows).
# «host.exacto» o «.sufijo», separados por comas. Normalmente no hace falta.
PUSH_ALLOWED_HOSTS=

# Solo si el backend corre detrás de un proxy propio que añade X-Forwarded-For (en Vercel no hace falta):
# activa 1 para que el limitador de intentos use la IP que ese proxy informa. Sin proxy déjalo vacío.
TRUST_PROXY_HEADERS=

# SECRET_KEY: usa al menos 32 caracteres aleatorios (openssl rand -hex 32).
