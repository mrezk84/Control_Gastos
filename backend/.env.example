# Database
# Local development:
DATABASE_URL=mysql://usuario:password@localhost/control_gastos
# Production (Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host/database

# Security
SECRET_KEY=genera_una_clave_secreta_segura_aqui
# Generate secure key with: openssl rand -hex 32

# Frontend
# Local development:
FRONTEND_URL=http://localhost:3000
# Production (Vercel/Render):
# FRONTEND_URL=https://control-gastos-frontend.vercel.app
# FRONTEND_URL=https://control-gastos-frontend.onrender.com

# OAuth (Opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# OCR (Opcional - usa Tesseract local si no se configura)
OCR_SPACE_API_KEY=