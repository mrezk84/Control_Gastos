# Secret Key para JWT (genera uno nuevo con: openssl rand -base64 64)
SECRET_KEY=tu_secret_key_aqui_genera_uno_nuevo_para_produccion
TOKEN_EXPIRATION=30

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql
DB_NAME=expense_tracker

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth (obtén desde https://console.cloud.google.com)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft OAuth (obtén desde https://portal.azure.com)
MICROSOFT_CLIENT_ID=tu_microsoft_client_id
MICROSOFT_CLIENT_SECRET=tu_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Apple Sign In (obtén desde https://developer.apple.com)
APPLE_CLIENT_ID=tu_apple_client_id
APPLE_TEAM_ID=tu_apple_team_id
APPLE_KEY_ID=tu_apple_key_id
APPLE_KEY_FILE=path/to/your/key.p8
APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback
