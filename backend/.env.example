# Base de datos (Neon Postgres)
# Neon > Dashboard > Connect > "Pooled connection" (el host lleva "-pooler").
DATABASE_URL=postgresql://<usuario>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Autenticación: clave para firmar los JWT. Generala con:  openssl rand -hex 32
SECRET_KEY=
# Minutos de vida del token de sesión (por defecto 1440 = 24 h)
TOKEN_EXPIRATION=1440

# URL(s) del frontend para CORS y redirecciones (separadas por coma si son varias)
# Local:
FRONTEND_URL=http://localhost:3000
# Producción:
# FRONTEND_URL=https://control-gastos.vercel.app

# URL pública de este backend (se usa para los callbacks de OAuth)
BACKEND_URL=http://localhost:8000

# Recuperación de contraseña por correo (Resend, gratis hasta 3000 correos/mes).
# Sin RESEND_API_KEY el enlace solo se escribe en el log del servidor.
RESEND_API_KEY=
EMAIL_FROM=Control Gastos <onboarding@resend.dev>

# OCR de recibos (https://ocr.space/ocrapi/freekey). Sin clave no se pueden escanear imágenes.
OCR_SPACE_API_KEY=

# Login social (opcional). Redirect URI a registrar: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI a registrar: {BACKEND_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
