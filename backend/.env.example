# Database (Supabase Postgres)
# Supabase > Project Settings > Database > Connection string (URI).
# Usá el "Session pooler" (puerto 5432) si tu hosting no soporta IPv6 (Render, Railway).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth
# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Solo si el proyecto usa el JWT secret legacy (HS256). Con las nuevas
# "JWT signing keys" (ES256/RS256) no hace falta: se validan con JWKS.
SUPABASE_JWT_SECRET=

# Solo para scripts/migrate_to_supabase.py — NUNCA en el frontend
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
# Local development:
FRONTEND_URL=http://localhost:3000
# Production (Vercel/Render):
# FRONTEND_URL=https://control-gastos-frontend.vercel.app

# OCR (Opcional - usa Tesseract local si no se configura)
OCR_SPACE_API_KEY=
